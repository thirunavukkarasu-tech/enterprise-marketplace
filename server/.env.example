# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/marketsphere

# ── Auth / JWT ────────────────────────────────────────────
JWT_ACCESS_SECRET=replace_with_a_long_random_string
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=replace_with_a_different_long_random_string
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=replace_with_another_long_random_string

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Redis (optional — leave blank to run without it) ───────
REDIS_URL=

# ── Object Storage (Cloudinary/S3-style — added in a later phase) ──
STORAGE_PROVIDER=cloudinary
STORAGE_CLOUD_NAME=
STORAGE_API_KEY=
STORAGE_API_SECRET=

# ── Email (abstraction wired in a later phase) ─────────────
EMAIL_FROM=no-reply@marketsphere.dev
