# Copy to .env and fill in real values. NEVER commit .env.
# Every variable here is validated at boot by src/config/env.js — the
# server refuses to start with a clear message rather than failing
# mysteriously later if a required one is missing or malformed.

# ── Server ────────────────────────────────────────────────
NODE_ENV=development
PORT=5000
API_VERSION=v1
CLIENT_URL=http://localhost:5173

# ── Database ──────────────────────────────────────────────
# Local standalone:  mongodb://127.0.0.1:27017/marketsphere
# Local replica set: mongodb://127.0.0.1:27017/marketsphere?replicaSet=rs0
#   (order creation and payment/order consistency use MongoDB
#    transactions, which require a replica set — see README.md)
MONGODB_URI=

# ── Auth / JWT ────────────────────────────────────────────
# Generate each with: openssl rand -base64 48
# Access and refresh secrets MUST be different values.
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRY=7d
COOKIE_SECRET=

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# ── Redis (optional — leave blank to run without it) ───────
REDIS_URL=

# ── Object Storage (not yet wired to any domain) ───────────
STORAGE_PROVIDER=cloudinary
STORAGE_CLOUD_NAME=
STORAGE_API_KEY=
STORAGE_API_SECRET=

# ── Email (abstraction only — dev logs links to the console) ──
EMAIL_FROM=no-reply@marketsphere.dev

# ── Payments ──────────────────────────────────────────────
# This app ships with a MOCK payment provider only (see
# src/utils/mockPaymentProvider.js) — no real gateway is integrated and
# no real money moves. A real provider integration would add its secret
# and webhook-signing secret here; both are left blank deliberately.
PAYMENT_PROVIDER=mock
PAYMENT_PROVIDER_SECRET=
PAYMENT_WEBHOOK_SECRET=
